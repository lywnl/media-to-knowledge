# 所有路径均相对项目工作区解析。
VIDEO_DEMO_RUNTIME_ROOT=.codex/video-rag-demo
VIDEO_DEMO_FFMPEG_PATH=
VIDEO_DEMO_FFPROBE_PATH=

# 外部服务。只在本地环境中填写，严禁提交真实值。
VIDEO_DEMO_QWEN_BASE_URL=
VIDEO_DEMO_QWEN_API_KEY=
VIDEO_DEMO_QWEN_MODEL_ID=
VIDEO_DEMO_OSS_ENDPOINT=
VIDEO_DEMO_OSS_BUCKET=
VIDEO_DEMO_OSS_ACCESS_KEY_ID=
VIDEO_DEMO_OSS_ACCESS_KEY_SECRET=
VIDEO_DEMO_OSS_PREFIX=video-demo/qwen-clips
VIDEO_DEMO_OSS_SIGNED_URL_TTL_SECONDS=3600
VIDEO_DEMO_BAIDU_OCR_ENDPOINT=https://aip.baidubce.com/rest/2.0/ocr/v1/accurate_basic
VIDEO_DEMO_BAIDU_API_KEY=
VIDEO_DEMO_BAIDU_SECRET_KEY=

# 单 Worker 串行执行云端语音窗口；子进程超时覆盖长视频总耗时。
VIDEO_DEMO_SPEECH_SUBPROCESS_TIMEOUT_SECONDS=3600
VIDEO_DEMO_WORKER_CONCURRENCY=1

# OpenAI 兼容云端 Whisper；API Key 只放本地环境，禁止提交真实值。
OPENAI_BASE_URL=https://ai-proxy.erda.cloud/v1
OPENAI_API_KEY=
OPENAI_MODEL=openai/whisper
OPENAI_ASR_TIMEOUT_SECONDS=300
OPENAI_ASR_MAX_ATTEMPTS=3

# 知识文档文本模型和章节视觉模型。Worker 启动时要求三组模型配置完整；API 进程不需要密钥。
VIDEO_DEMO_TEXT_LLM_BASE_URL=
VIDEO_DEMO_TEXT_LLM_API_KEY=
VIDEO_DEMO_TEXT_LLM_MODEL_ID=
VIDEO_DEMO_TEXT_LLM_TIMEOUT_SECONDS=120
VIDEO_DEMO_TEXT_LLM_MAX_ATTEMPTS=3
VIDEO_DEMO_VLM_BASE_URL=
VIDEO_DEMO_VLM_API_KEY=
VIDEO_DEMO_VLM_MODEL_ID=qwen3-vl-flash
VIDEO_DEMO_VLM_TIMEOUT_SECONDS=180
VIDEO_DEMO_VLM_MAX_ATTEMPTS=3
# 仅本机端点测试显式开启；生产默认只接受 HTTPS。
VIDEO_DEMO_ALLOW_INSECURE_LOCAL_MODEL_ENDPOINT=false
